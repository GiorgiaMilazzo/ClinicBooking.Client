@page "/appointments"
@attribute [Authorize]
@inject AppointmentService AppointmentService
@inject DoctorService DoctorService
@inject PatientService PatientService
@using System.ComponentModel.DataAnnotations

<PageTitle>Appuntamenti</PageTitle>

<h1>Appuntamenti</h1>

<section class="mb-4">
    <h2>Nuovo appuntamento</h2>

    @if (isFormLoading)
    {
        <p><em>Caricamento medici e pazienti...</em></p>
    }
    else
    {
        <EditForm Model="newAppointment" OnValidSubmit="CreateAppointmentAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label" for="doctor">Medico</label>
                <InputSelect id="doctor" class="form-select" @bind-Value="newAppointment.DoctorId">
                    <option value="0">Seleziona un medico</option>
                    @foreach (var doctor in doctors)
                    {
                        <option value="@doctor.Id">
                            @doctor.Name @doctor.Lastname - @(doctor.Specialization ?? "Specializzazione non indicata")
                        </option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label" for="patient">Paziente</label>
                <InputSelect id="patient" class="form-select" @bind-Value="newAppointment.PatientId">
                    <option value="0">Seleziona un paziente</option>
                    @foreach (var patient in patients)
                    {
                        <option value="@patient.Id">@patient.Name @patient.Lastname</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label" for="appointmentDate">Data e ora</label>
                <InputDate id="appointmentDate"
                           class="form-control"
                           @bind-Value="newAppointment.DateTimeAppointment"
                           Type="InputDateType.DateTimeLocal" />
            </div>

            @if (!string.IsNullOrWhiteSpace(formMessage))
            {
                <div class="alert alert-danger">@formMessage</div>
            }

            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Salvataggio..." : "Crea appuntamento")
            </button>
        </EditForm>
    }
</section>

@if (isLoading)
{
    <p><em>Caricamento in corso...</em></p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (appointments.Count == 0)
{
    <p>Nessun appuntamento disponibile.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Data e ora</th>
                <th>Medico</th>
                <th>Paziente</th>
                <th>Stato</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in appointments)
            {
                <tr>
                    <td>@appointment.DateTimeAppointment.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@appointment.DoctorName</td>
                    <td>@appointment.PatientName</td>
                    <td>@GetStatusLabel(appointment.Status)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Appointment> appointments = [];
    private List<Doctor> doctors = [];
    private List<Patient> patients = [];
    private readonly CreateAppointmentRequest newAppointment = new()
    {
        DateTimeAppointment = DateTime.Now
    };
    private bool isLoading = true;
    private bool isFormLoading = true;
    private bool isSubmitting;
    private string? errorMessage;
    private string? formMessage;

    protected override async Task OnInitializedAsync()
    {
        var appointmentsTask = AppointmentService.GetAllAsync();
        var doctorsTask = DoctorService.GetAllAsync();
        var patientsTask = PatientService.GetAllAsync();
        await Task.WhenAll(appointmentsTask, doctorsTask, patientsTask);

        var result = await appointmentsTask;
        isLoading = false;

        if (result.Success)
        {
            appointments = result.Data ?? [];
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        var doctorsResult = await doctorsTask;
        var patientsResult = await patientsTask;
        isFormLoading = false;

        if (doctorsResult.Success && patientsResult.Success)
        {
            doctors = doctorsResult.Data ?? [];
            patients = patientsResult.Data ?? [];
        }
        else
        {
            formMessage = doctorsResult.ErrorMessage ?? patientsResult.ErrorMessage;
        }
    }

    private async Task CreateAppointmentAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        formMessage = null;

        var result = await AppointmentService.CreateAsync(newAppointment);
        if (result.Success)
        {
            var appointmentsResult = await AppointmentService.GetAllAsync();
            if (appointmentsResult.Success)
            {
                appointments = appointmentsResult.Data ?? [];
                newAppointment.DoctorId = 0;
                newAppointment.PatientId = 0;
                newAppointment.DateTimeAppointment = DateTime.Now;
            }
            else
            {
                formMessage = appointmentsResult.ErrorMessage;
            }
        }
        else
        {
            formMessage = result.ErrorMessage;
        }

        isSubmitting = false;
    }

    private static string GetStatusLabel(AppointmentStatus status)
    {
        return status switch
        {
            AppointmentStatus.Booked => "Prenotato",
            AppointmentStatus.Confirmed => "Confermato",
            AppointmentStatus.Complete => "Completato",
            _ => "Stato non riconosciuto"
        };
    }
}
